// Dorixona platformasi — ma'lumotlar bazasi sxemasi
// Prisma 7 + PostgreSQL
// Hujjat: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
//  Foydalanuvchilar va rollar (dashboard'ga kiradiganlar)
// ─────────────────────────────────────────────────────────────

enum Role {
  OWNER // egasi
  MANAGER // menejer
  PHARMACIST // farmatsevt
  CASHIER // kassir
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role      @default(MANAGER)
  isActive     Boolean   @default(true)
  telegramId   BigInt?   @unique // xodim Telegram'i (Mini App'ga birinchi kirganda bog'lanadi)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee     Employee? // ixtiyoriy: kirish profili xodimga bog'lanishi mumkin
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([branchId])
}

// ─────────────────────────────────────────────────────────────
//  Filiallar (hozircha 1 ta, lekin ko'p filialga tayyor)
// ─────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  name      String // masalan: "Chilonzor filiali"
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  employees Employee[]
  products  Product[]
  sales     Sale[]
  expenses  Expense[]
  monthlyFinance MonthlyFinance[]
  debts     Debt[]
  customers Customer[]
}

// ─────────────────────────────────────────────────────────────
//  Xodimlar
// ─────────────────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE // aktiv
  ON_LEAVE // ta'tilda
  INACTIVE // ishdan bo'shagan
}

model Employee {
  id         String         @id @default(cuid())
  fullName   String
  position   String // Farmatsevt, Kassa xodimi...
  phone      String?
  baseSalary Decimal        @db.Decimal(14, 2) // base maosh (so'm)
  status     EmployeeStatus @default(ACTIVE)
  hiredAt    DateTime       @default(now())
  unit       String? // qaysi dorixona: Yunusobod / Shayxontohur (bo'sh = umumiy)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Dashboard'ga kirish uchun (ixtiyoriy)
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  sales       Sale[]
  attendances Attendance[]
  kpiRecords  KpiRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
  @@index([unit])
}

// ─────────────────────────────────────────────────────────────
//  Ombor — mahsulotlar (dorilar)
// ─────────────────────────────────────────────────────────────

model Product {
  id         String    @id @default(cuid())
  name       String // Amoxicillin 500mg
  sku        String? // kod
  category   String // Antibiotik, Vitaminlar...
  unit       String    @default("dona")
  costPrice  Decimal   @db.Decimal(14, 2) // tan narxi
  salePrice  Decimal   @db.Decimal(14, 2) // sotuv narxi (dona)
  stock      Int       @default(0) // joriy qoldiq
  minStock   Int       @default(0) // minimal norma
  expiryDate DateTime? // muddati (yaqin partiya)
  isActive   Boolean   @default(true)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, sku])
  @@index([branchId])
  @@index([category])
}

// Ombor harakatlari (qabul / sotuv / hisobdan chiqarish) — analitika uchun
enum MovementType {
  IN // qabul (yangi partiya)
  OUT // sotuv
  ADJUST // tuzatish / hisobdan chiqarish
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      MovementType
  quantity  Int // musbat son; type yo'nalishni belgilaydi
  note      String?
  createdAt DateTime     @default(now())

  @@index([productId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
//  Mijozlar va sodiqlik (Telegram bot orqali)
// ─────────────────────────────────────────────────────────────

enum LoyaltyTier {
  BRONZE // Bronza
  SILVER // Kumush
  GOLD // Oltin
}

model Customer {
  id            String      @id @default(cuid())
  fullName      String?
  phone         String      @unique // asosiy identifikator
  telegramId    BigInt?     @unique // Telegram user id
  telegramUser  String? // @username
  cardCode      String      @unique // bonus karta: FP-00123
  points        Int         @default(0) // joriy bonus ballari
  totalSpent    Decimal     @default(0) @db.Decimal(16, 2) // jami xarid (tier uchun)
  tier          LoyaltyTier @default(BRONZE)
  birthday      DateTime?
  registeredVia String      @default("telegram")

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  sales               Sale[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([telegramId])
}

enum LoyaltyTxnType {
  EARN // xariddan ball to'plash
  REDEEM // ballarni ishlatish
  SIGNUP_BONUS // ro'yxatdan o'tish bonusi
  ADJUST // qo'lda tuzatish
}

model LoyaltyTransaction {
  id         String         @id @default(cuid())
  customerId String
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       LoyaltyTxnType
  points     Int // musbat = qo'shildi, manfiy = ishlatildi
  saleId     String?
  sale       Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  note       String?
  createdAt  DateTime       @default(now())

  @@index([customerId])
}

// ─────────────────────────────────────────────────────────────
//  Savdo (POS)
// ─────────────────────────────────────────────────────────────

enum PaymentMethod {
  CASH // naqd
  CARD // terminal
  MIXED // aralash
}

model Sale {
  id             String        @id @default(cuid())
  receiptNo      String        @unique // chek raqami
  total          Decimal       @db.Decimal(16, 2) // yakuniy summa (chegirmadan keyin)
  discount       Decimal       @default(0) @db.Decimal(16, 2)
  pointsEarned   Int           @default(0)
  pointsRedeemed Int           @default(0)
  paymentMethod  PaymentMethod @default(CASH)
  unit           String? // qaysi dorixona: Yunusobod / Shayxontohur (bo'sh = ajratilmagan)

  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items               SaleItem[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([employeeId])
  @@index([customerId])
  @@index([createdAt])
  @@index([unit])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal @db.Decimal(14, 2) // sotilgan paytdagi narx
  costPrice Decimal @db.Decimal(14, 2) // marja hisoblash uchun
  lineTotal Decimal @db.Decimal(16, 2)

  @@index([saleId])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
//  Harajatlar
// ─────────────────────────────────────────────────────────────

enum ExpenseCategory {
  RENT // ijara
  UTILITIES // kommunal
  GOODS // tovar / yetkazib berish
  SALARY // maosh fondi
  LICENSE // litsenziya / rasmiy
  OTHER // boshqa
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(16, 2)
  spentAt     DateTime        @default(now())
  isRecurring Boolean         @default(false) // doimiy xarajatmi
  unit        String? // qaysi dorixona: Yunusobod / Shayxontohur (bosh = umumiy)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([branchId])
  @@index([spentAt])
  @@index([unit])
}

// ─────────────────────────────────────────────────────────────
//  Davomat
// ─────────────────────────────────────────────────────────────

enum AttendanceStatus {
  PRESENT // keldi
  LATE // kechikdi
  ABSENT // kelmadi
  ON_LEAVE // ta'tilda (ruxsatli)
}

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkIn     DateTime?
  lateMinutes Int              @default(0)
  penalty     Int              @default(0) // KPI davomat qismidan chegiriladigan ball
  status      AttendanceStatus @default(PRESENT)

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
//  KPI — oylik baholash (100 ballik)
//  Tarkib: Savdo 40% + Marja 20% + Davomat 15% + Intizom 10% + Mijoz 15%
// ─────────────────────────────────────────────────────────────

model KpiRecord {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  month      Int // 1-12

  salesScore      Int @default(0) // 0-100 (og'irlik 40%)
  marginScore     Int @default(0) // 0-100 (og'irlik 20%)
  attendanceScore Int @default(0) // 0-100 (og'irlik 15%)
  disciplineScore Int @default(0) // 0-100 (og'irlik 10%)
  customerScore   Int @default(0) // 0-100 (og'irlik 15%)

  totalScore   Int     @default(0) // yakuniy 0-100
  bonusPercent Int     @default(0) // bonus foizi
  bonusAmount  Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
}


// -------------------------------------------------------------
//  OYLIK MOLIYAVIY XULOSA
// -------------------------------------------------------------
model MonthlyFinance {
  id          String   @id @default(cuid())
  unit        String
  periodMonth DateTime
  turnover    Decimal  @default(0) @db.Decimal(16, 2)
  profit      Decimal  @default(0) @db.Decimal(16, 2)
  stockValue  Decimal  @default(0) @db.Decimal(16, 2)
  revaluation Decimal  @default(0) @db.Decimal(16, 2)
  bankBalance Decimal? @db.Decimal(16, 2)
  note        String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([unit, periodMonth])
  @@index([branchId])
  @@index([periodMonth])
}

enum DebtDirection {
  RECEIVABLE
  PAYABLE
}

/// Qarz turi: firmadan olingan tovar qarzi yoki ko'chadagi naqd qarz
enum DebtKind {
  FIRM
  STREET
}

enum DebtCurrency {
  UZS
  USD
}

/// Qarz harakati: yangi qarz (CHARGE) yoki to'lov (PAYMENT)
enum DebtEntryType {
  CHARGE
  PAYMENT
}

// ─────────────────────────────────────────────────────────────
//  Integratsiya jurnali
//
//  Vercel Hobby tarifda loglar qisqa saqlanadi, shuning uchun
//  F-Apteka nima yuborayotganini bazaga yozamiz — keyin istalgan
//  vaqtda SQL bilan ko'rish mumkin.
// ─────────────────────────────────────────────────────────────

model IntegrationLog {
  id        String   @id @default(cuid())
  source    String // "fapteka-site" | "fapteka-auto"
  rowCount  Int      @default(0)
  keys      String? // kelgan maydonlar: "I:120,N:120,K:120"
  sample    String? // bitta namuna qator (JSON)
  note      String?
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([source, createdAt])
  @@index([createdAt]) // bosh sahifa: oxirgi yozuv (source'siz)
}

model Debt {
  id           String        @id @default(cuid())
  counterparty String
  direction    DebtDirection
  kind         DebtKind      @default(FIRM)
  currency     DebtCurrency  @default(UZS)
  /// Jami olingan qarz — CHARGE harakatlari yig'indisi
  totalAmount  Decimal       @db.Decimal(16, 2)
  /// To'langani — PAYMENT harakatlari yig'indisi
  paidAmount   Decimal       @default(0) @db.Decimal(16, 2)
  /// To'lash muddati; kirimga qarab qo'yiladi
  dueDate      DateTime?
  /// Yopilgan sana (qoldiq nolga tushganda)
  closedAt     DateTime?
  unit         String?
  note         String?

  entries  DebtEntry[]
  branchId String
  branch   Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([branchId])
  @@index([direction])
  @@index([kind, closedAt])
  @@index([dueDate])
}

/// Qarz tarixi: "shuncha berildi, shuncha qoldi" shu yerdan hisoblanadi
model DebtEntry {
  id        String        @id @default(cuid())
  /// F-Apteka hujjatidan kelgan bo'lsa: "FA:INC:1112" — takror yozilmasligi uchun
  ref       String?       @unique
  debtId    String
  debt      Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
  type      DebtEntryType
  amount    Decimal       @db.Decimal(16, 2)
  happenedAt DateTime     @default(now())
  note      String?

  createdAt DateTime @default(now())

  @@index([debtId, happenedAt])
}

/// F-Apteka tashkilotlari (189-hisobot): yetkazib beruvchi, filial,
/// sug'urta kompaniyasi. Kirim harajatida kimdan kelganini yozish uchun.
model FaptekaOrg {
  id        String   @id // F-Apteka tashkilot ID
  name      String
  inn       String?
  isSupplier Boolean @default(false)
  updatedAt DateTime @default(now()) @updatedAt

  @@index([inn])
}

/// F-Apteka 22-hisobotidan kunlik savdo — hujjat turi (DOCTYPE) kesimida.
/// Naqd va terminal shu yerdan ajratiladi: 4-hisobotda to'lov turi yo'q,
/// 22-hisobotda esa har hujjatning turi bor.
model DailySales {
  id      String   @id @default(cuid())
  day     DateTime
  /// Dorixona nomi; ajratilmagan bo'lsa "Umumiy" (NULL emas — takror yozuv bo'lmasin)
  unit    String   @default("Umumiy")
  docType String // F-Apteka DOCTYPE: 2, 4, 7, 3, 8 ...
  amount  Decimal  @db.Decimal(16, 2)
  cost    Decimal  @default(0) @db.Decimal(16, 2)

  updatedAt DateTime @default(now()) @updatedAt

  @@unique([day, unit, docType])
  @@index([day])
}

/// Narx nazoratidagi dori: raqobatchidagi eng arzon narx kuzatiladi
model PriceWatch {
  id              String    @id @default(cuid())
  /// Ro'yxatdagi nom (ПАРАЦЕТАМОЛ) — shu nom bo'yicha bizning tovar topiladi
  name            String    @unique
  /// arzonapteka.uz dagi mahsulot sahifasi
  sourceUrl       String?
  sourceTitle     String?
  /// Toshkentdagi eng arzon narx
  competitorPrice Decimal?  @db.Decimal(16, 2)
  checkedAt       DateTime?
  /// Bizning tovar (Product.sku), topilgan bo'lsa
  sku             String?
  /// Shu doriga alohida ustama; bo'sh bo'lsa dorixona sozlamasi ishlatiladi
  percent         Decimal?  @db.Decimal(5, 2)
  active          Boolean   @default(true)
  /// "Narx nazorati ro'yxati"dagi dori. false — faqat ustama foizi uchun
  /// yaratilgan qator. Ustun ilova tomonidan o'zi qo'shiladi
  /// (ensurePriceWatchListed), qo'lda SQL shart emas.
  listed          Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([checkedAt])
  @@index([active])
}

/// Har bir dorixona uchun ustama sozlamasi
model PriceSetting {
  /// Dorixona nomi: Yunusobod, Shayxontohur
  unit      String   @id
  enabled   Boolean  @default(true)
  /// Arzonaptekada kuzatiladigan doriga ustama (5 = 5%)
  percent   Decimal  @default(5) @db.Decimal(5, 2)
  /// Qolgan dorilarga: tan narx ustiga qo'shiladigan foiz. 0 bo'lsa
  /// tavsiya berilmaydi — dorixona o'zi foiz qo'yguncha kutiladi.
  costPercent Decimal @default(0) @db.Decimal(5, 2)
  updatedAt DateTime @default(now()) @updatedAt
}

/// SITE.exe dan kelgan oxirgi chakana narx (dorixona × dori).
/// Keyingi push'da narx o'zgargani shu bilan solishtiriladi.
model FaptekaPrice {
  /// F-Apteka otdel: 2 = Yunusobod, 3 = Shayxontohur
  otdel     String
  /// F-Apteka tovar ID (SITE.exe "I")
  fid       String
  price     Decimal  @db.Decimal(16, 2)
  qty       Decimal  @db.Decimal(14, 4)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([otdel, fid])
}

/// Pereotsenka: dorixonada dori narxi o'zgargan payt. Summa = qoldiq × (yangi − eski)
model Revaluation {
  id       String   @id @default(cuid())
  unit     String
  otdel    String
  fid      String
  name     String
  oldPrice Decimal  @db.Decimal(16, 2)
  newPrice Decimal  @db.Decimal(16, 2)
  qty      Decimal  @db.Decimal(14, 4)
  amount   Decimal  @db.Decimal(16, 2)
  at       DateTime @default(now())

  @@index([unit, at])
}

/// Kassir smenasi — F-Apteka cheklaridan (NGLOBAL.INVOICE: SMENA, USERS).
/// F-Apteka'ning SMENA jadvali eskirgan, shuning uchun smena cheklardan
/// tuziladi: birinchi va oxirgi chek vaqti, cheklar soni, savdo.
model CashierShift {
  id        String   @id @default(cuid())
  /// Dorixona: Yunusobod, Shayxontohur
  unit      String
  /// F-Apteka SMENA ID
  shiftId   String
  /// F-Apteka USERS ID (kassir)
  userId    String
  cashier   String
  openedAt  DateTime
  closedAt  DateTime
  /// Smena ochilgan kun (Toshkent sanasi, UTC yarim tunda)
  day       DateTime
  checks    Int      @default(0)
  sales     Decimal  @default(0) @db.Decimal(16, 2)
  returns   Decimal  @default(0) @db.Decimal(16, 2)
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([unit, shiftId, userId])
  @@index([day])
}
